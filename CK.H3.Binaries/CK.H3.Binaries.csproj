<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CK.H3\CK.H3.csproj" />
  </ItemGroup>

  <!--
    NuGet layout: runtimes/{rid}/native/ is the standard convention.
    dotnet restore generates the deps.json entries so the runtime resolves the
    right binary automatically — no platform-detection code needed in the consumer.
  -->
  <ItemGroup>
    <Content Include="runtimes\**\*.*" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>

  <!--
    Project-reference builds (e.g. unit tests referencing this project directly)
    do not go through NuGet restore, so no deps.json entries are generated for the
    native library.  Including the host-platform binary as a None item with
    CopyToOutputDirectory="PreserveNewest" propagates it transitively through
    ProjectReference chains via GetCopyToOutputDirectoryItems.
    TargetPath places the file at the output root so LibraryImport("h3") finds it.

    The host RID is computed from the OS and the architecture, not from NETCoreSdkRuntimeIdentifier:
    a distribution-built SDK reports a RID like "ubuntu.24.04-x64" that matches no runtimes folder.
    Linux hosts use the glibc build, except Alpine (or a musl SDK) that uses the musl build.
  -->
  <PropertyGroup>
    <_H3HostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_H3HostArch>
    <_H3HostRid Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-$(_H3HostArch)</_H3HostRid>
    <_H3HostRid Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-$(_H3HostArch)</_H3HostRid>
    <_H3HostRid Condition="$([MSBuild]::IsOSPlatform('Linux')) AND ($(NETCoreSdkRuntimeIdentifier.Contains('musl')) OR Exists('/etc/alpine-release'))">linux-musl-$(_H3HostArch)</_H3HostRid>
    <_H3NativeLibName Condition="$([MSBuild]::IsOSPlatform('Windows'))">h3.dll</_H3NativeLibName>
    <_H3NativeLibName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libh3.so</_H3NativeLibName>
    <_H3NativeSrc>runtimes\$(_H3HostRid)\native\$(_H3NativeLibName)</_H3NativeSrc>
  </PropertyGroup>

  <ItemGroup Condition="'$(_H3NativeLibName)' != '' AND Exists('$(_H3NativeSrc)')">
    <None Include="$(_H3NativeSrc)" CopyToOutputDirectory="PreserveNewest" TargetPath="$(_H3NativeLibName)" Pack="false" />
  </ItemGroup>

</Project>
